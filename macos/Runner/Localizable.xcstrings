      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключить Elarni"
          }
        }
      }
    },
    "Connects to the server selected in Elarni." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключается к серверу, выбранному в Elarni."
