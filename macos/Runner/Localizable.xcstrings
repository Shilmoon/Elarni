{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld subscription(s) expire within three days. Open Elarni for details." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld подписки заканчиваются в ближайшие три дня. Откройте Elarni, чтобы узнать подробности."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld подписок заканчиваются в ближайшие три дня. Откройте Elarni, чтобы узнать подробности."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld подписка заканчивается в ближайшие три дня. Откройте Elarni, чтобы узнать подробности."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld подписки заканчиваются в ближайшие три дня. Откройте Elarni, чтобы узнать подробности."
                }
              }
            }
          }
        }
      }
    },
    "A link asks Elarni to disconnect." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка просит Elarni отключиться."
          }
        }
      }
    },
    "A link wants to import a client profile." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка хочет импортировать профиль клиента."
          }
        }
      }
    },
    "A link wants to import a routing profile." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка хочет импортировать профиль маршрутизации."
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмена"
          }
        }
      }
    },
    "Choose applications or executables" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите приложения или исполняемые файлы"
