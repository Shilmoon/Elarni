    "Disconnect Elarni" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить Elarni"
          }
        }
      }
    },
    "Disconnects Elarni and keeps On Demand from reconnecting it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключает Elarni и не даёт «По требованию» подключить его снова."
          }
        }
      }
    },
    "Disconnects Elarni when it runs, and connects it otherwise." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключает Elarni, если он работает, и подключает в противном случае."
          }
        }
      }
    },
    "Elarni could not change the connection. Try it in the Elarni window to see why." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elarni не удалось изменить подключение. Повторите это в окне Elarni, чтобы увидеть причину."
          }
        }
      }
    },
    "Elarni did not finish opening. Try again." : {
      "localizations" : {
