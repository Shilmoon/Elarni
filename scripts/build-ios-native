#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
usage='usage: scripts/build-ios-native [iphoneos|iphonesimulator] [--dev]'
[ "$#" -le 2 ] || { echo "$usage" >&2; exit 2; }
platform=${1:-iphonesimulator}
# A device build compiles Rust at the macOS release build's profile; the simulator, and a
# device build with --dev (CI's compile check), use the quicker native-dev profile.
case "$platform" in
  iphoneos) target=aarch64-apple-ios; triple=arm64-apple-ios18.0; profile=release ;;
  iphonesimulator) target=aarch64-apple-ios-sim; triple=arm64-apple-ios18.0-simulator; profile=native-dev ;;
  *) echo "$usage" >&2; exit 2 ;;
esac
case "${2:-}" in
  '') ;;
  --dev) profile=native-dev ;;
  *) echo "$usage" >&2; exit 2 ;;
esac
go_command=${ELARNI_GO:-go}
# Go leaves CPU feature detection out of GOOS=ios builds until upstream commit 8058a577, so
# AES-GCM and SHA-256 would run without the CPU's AES and SHA instructions. The commit's diff
# is applied to copies of the toolchain's files, which the Go build below reads through
# -overlay; the toolchain itself is never changed.
goroot=$(GOTOOLCHAIN=local GOFLAGS= "$go_command" env GOROOT)
cpu_source="$goroot/src/internal/cpu"
cpu_patch="$root/scripts/go-ios-cpu-features.patch"
overlay_dir="$root/.build/ios/go-overlay"
overlay=
if [ ! -f "$cpu_source/cpu_arm64_darwin.go" ]; then
  printf 'error: %s is missing, so %s cannot be applied\n' "$cpu_source/cpu_arm64_darwin.go" "$cpu_patch" >&2
  exit 1
elif ! grep -q '^//go:build.*!ios' "$cpu_source/cpu_arm64_darwin.go"; then
  printf 'Go detects CPU features on iOS itself (%s); %s is not applied\n' "$cpu_source/cpu_arm64_darwin.go" "$cpu_patch"
else
  rm -rf "$overlay_dir"
  mkdir -p "$overlay_dir/src/internal/cpu"
  for file in cpu_arm64_darwin.go cpu_arm64_other.go cpu_darwin.go; do
    cp "$cpu_source/$file" "$overlay_dir/src/internal/cpu/$file"
  done
  # No fuzz and no guessing at a reversed patch: a changed file fails the build.
  if ! patch_output=$(patch -p1 -F0 -f -d "$overlay_dir" -i "$cpu_patch" 2>&1); then
    printf '%s\n' "$patch_output" >&2
    printf "error: %s does not apply to the files in %s; without it the iOS core encrypts without the CPU's AES and SHA instructions\n" \
      "$cpu_patch" "$cpu_source" >&2
    exit 1
  fi
  overlay="$overlay_dir/overlay.json"
  {
    printf '{"Replace":{'
    separator=
    for file in cpu_arm64_darwin.go cpu_arm64_other.go cpu_darwin.go; do
      printf '%s"%s":"%s"' "$separator" "$cpu_source/$file" "$overlay_dir/src/internal/cpu/$file"
      separator=,
    done
    printf '}}\n'
  } > "$overlay"
fi
output="$root/.build/ios/Native/$platform"
mkdir -p "$output"
IPHONEOS_DEPLOYMENT_TARGET=18.0 cargo build --locked --profile "$profile" \
  --target "$target" --target-dir "$root/.build/ios/rust" \
  -p elarni-domain -p elarni-packet-bridge
cp "$root/.build/ios/rust/$target/$profile/libelarni_domain.a" "$output/"
cp "$root/.build/ios/rust/$target/$profile/libelarni_packet_bridge.a" "$output/"
# The ShadowQUIC client, which the app and its network extension link next to the core.
IPHONEOS_DEPLOYMENT_TARGET=18.0 cargo build --locked --profile "$profile" \
  --target "$target" --target-dir "$root/.build/ios/rust" -p elarni-shadowquic --lib
cp "$root/.build/ios/rust/$target/$profile/libelarni_shadowquic.a" "$output/"
sdk=$(xcrun --sdk "$platform" --show-sdk-path)
compiler=$(xcrun --sdk "$platform" --find clang)
flags="-target $triple -isysroot $sdk"
# ELARNI_RECORDING=1 builds the core with its connection recorder; the app then needs
# the ELARNI_RECORDING Swift condition too (docs/DIAGNOSTICS.md).
tags=-tags=elarni_shadowquic_static
[ "${ELARNI_RECORDING:-}" != 1 ] || tags=-tags=elarni_shadowquic_static,elarni_recording
cd "$root/Vendor/libXray"
GOWORK="$root/go.work" GOTOOLCHAIN=local GOFLAGS= GOOS=ios GOARCH=arm64 CGO_ENABLED=1 \
  CC="$compiler" CGO_CFLAGS="$flags" CGO_CXXFLAGS="$flags" CGO_LDFLAGS="$flags" \
  "$go_command" build $tags ${overlay:+"-overlay=$overlay"} -mod=readonly -trimpath -ldflags '-s -w -buildid=' \
  -buildmode=c-archive -o "$output/libXray.a" ./cgo_bridge
printf 'Built native libraries for %s (Rust profile %s)\n' "$platform" "$profile"
