#!/usr/bin/env python3
"""Package an existing Linux release bundle as a .deb, an AppImage and a portable .tar.gz.

The AppImage carries the tray libraries of this Ubuntu 22.04 build system (patchelf needed); their source packages
go into a .tar beside it. The build image of scripts/check-linux-container keeps them; elsewhere apt-get source fetches
them, which needs deb-src entries and a current apt-get update.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from release_support import prepare_output, require_files, write_manifest

ROOT=Path(__file__).resolve().parent.parent
# appimagetool and the type 2 runtime it embeds, pinned to published releases and their GitHub digests.
APPIMAGE_TOOLS={
    'appimagetool':('https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage',
        'ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0'),
    'runtime':('https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64',
        '2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d'),
}
DEPENDENCIES=('libc6 (>= 2.35), libgcc-s1, libstdc++6, libgtk-3-0, '
    'libayatana-appindicator3-1, libgstreamer1.0-0, libgstreamer-plugins-base1.0-0, '
    'gstreamer1.0-plugins-base, gstreamer1.0-plugins-good, libsecret-tools, '
    'iproute2, nftables, iputils-ping, pkexec | policykit-1, xdg-utils, desktop-file-utils, dbus, libglib2.0-bin')
# The tray's libraries, which the AppImage carries: Debian 13, Fedora, Arch and openSUSE install none of the ayatana
# ones with a desktop. GTK, GLib and the rest stay with the system; the .deb and the portable archive use the
# system's copies of these too.
BUNDLED_LIBRARIES=('libayatana-appindicator3.so.1','libayatana-indicator3.so.7','libayatana-ido3-0.4.so.0',
    'libdbusmenu-glib.so.4','libdbusmenu-gtk3.so.4')
# Where the AppImage keeps each carried package's licence file, as usr/share/doc/<package>/copyright of Debian.
BUNDLED_NOTICES='usr/share/doc/elarni/bundled'
# The source packages of the installed tray libraries, which the build image fetched with them, so packaging needs no
# package archive (scripts/check-linux-container).
BUNDLED_SOURCES_CACHE=Path('/usr/src/elarni-bundled-sources')
# The THIRD_PARTY_NOTICES section that names each carried library's package and source package versions.
NOTICES_SECTION='## Linux AppImage only: tray libraries'

def root_owned(info):
    # Root may extract the portable archive; keep neither the builder's ids nor group/other write.
    info.uid=info.gid=0
    info.uname=info.gname='root'
    info.mode&=~0o022
    return info

def appimage_tool(name):
    """A pinned AppImage tool, downloaded once into .build/appimage-tools and checked on every use."""
    url,expected=APPIMAGE_TOOLS[name]
    path=ROOT/'.build/appimage-tools'/(expected[:16]+'-'+name)
    if not path.is_file():
        path.parent.mkdir(parents=True,exist_ok=True)
        with urllib.request.urlopen(url,timeout=300) as response: data=response.read()
        partial=path.with_suffix('.partial');partial.write_bytes(data);partial.replace(path)
    actual=hashlib.sha256(path.read_bytes()).hexdigest()
    if actual!=expected: raise SystemExit(f'{path}: SHA-256 {actual} is not the pinned {expected}')
    path.chmod(0o755)
    return path

def bundled_libraries(documentation=Path('/usr/share/doc')):
    """Each library the AppImage carries: its file on this Ubuntu build system and the package that installed it."""
    if sys.platform!='linux' or not shutil.which('dpkg-query'):
        raise SystemExit('The AppImage takes its tray libraries from an Ubuntu build system.')
    known=subprocess.run([shutil.which('ldconfig') or '/sbin/ldconfig','-p'],check=True,capture_output=True,text=True).stdout
    libraries=[]
    for soname in BUNDLED_LIBRARIES:
        found=re.search(r'^\s*'+re.escape(soname)+r' \(libc6,x86-64\) => (\S+)$',known,re.M)
        if not found: raise SystemExit(f'The AppImage carries {soname}: install its package on the build system.')
        path=Path(found[1]).resolve(strict=True)
        # "<package>:<architecture>: <path>". The package name alone also matches another architecture's copy (an
        # i386 one, for Steam or Wine), whose record dpkg-query -W would print too.
        owner=subprocess.run(['dpkg-query','-S',str(path)],check=True,capture_output=True,text=True).stdout.split(': ',1)[0]
        package=owner.split(':',1)[0]
        version,source,source_version=subprocess.run(['dpkg-query','-W','-f=${Version}\t${source:Package}\t${source:Version}',
            owner],check=True,capture_output=True,text=True).stdout.split('\t')
        copyright=documentation/package/'copyright'
        if not copyright.is_file() or not copyright.stat().st_size:
            raise SystemExit(f'Missing licence file of bundled {soname}: {copyright}')
        libraries.append({'soname':soname,'path':path,'package':package,'version':version,'source':source,
            'source_version':source_version,'copyright':copyright})
    return libraries

def check_notices(libraries,notices):
    """Refuse a THIRD_PARTY_NOTICES whose tray library section names other packages or versions than the AppImage
    carries, so the notices it ships describe what it ships."""
    text=notices.read_text()
    start=text.find(NOTICES_SECTION)
    end=text.find('\n## ',start+1) if start>=0 else -1
    section=' '.join(text[start:end if end>=0 else len(text)].split()) if start>=0 else ''
    expected=[f"`{library['soname']}`: package `{library['package']}` {library['version']}, from source package "
        f"`{library['source']}` {library['source_version']}." for library in libraries]
    missing=[line for line in expected if line not in section]
    if missing:
        raise SystemExit(f'{notices} does not name the tray libraries the AppImage carries; its "{NOTICES_SECTION[3:]}" '
            'section must say:\n'+'\n'.join(missing))

def source_files(dsc):
    """The files a source package's .dsc lists, by name, with their SHA-256."""
    files,listed={},False
    for line in dsc.read_text(errors='replace').splitlines():
        if listed and line.startswith(' '):
            digest,_size,name=line.split()
            files[name]=digest
        else:
            listed=line.rstrip()=='Checksums-Sha256:'
    return files

def cached_source(dsc,folder):
    """Copy a source package the build image keeps, its .dsc and the files that lists, into folder. False, copying
    nothing, when there is none or one of its files is missing or differs."""
    if not dsc.is_file(): return False
    files=source_files(dsc)
    if not files: return False
    for name,digest in files.items():
        path=dsc.parent/name
        if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest()!=digest: return False
    for name in (dsc.name,*files): shutil.copy2(dsc.parent/name,folder/name)
    return True

def bundled_sources(libraries,archive,version,cache=BUNDLED_SOURCES_CACHE):
    """Write the exact Ubuntu source packages of the carried libraries, which their GPL and LGPL terms require
    beside the AppImage, with a README naming the library each one builds, to the archive. Each comes from the build
    image's cache, or from apt-get source where that lacks it."""
    with tempfile.TemporaryDirectory(prefix='elarni-bundled-sources-') as temporary:
        folder=Path(temporary)/archive.name.removesuffix('.tar')
        folder.mkdir()
        for source,source_version in sorted({(library['source'],library['source_version']) for library in libraries}):
            dsc=f"{source}_{source_version.split(':',1)[-1]}.dsc"
            if cached_source(cache/dsc,folder): continue
            fetched=subprocess.run(['apt-get','source','--download-only','-qq',f'{source}={source_version}'],cwd=folder,
                capture_output=True,text=True)
            if fetched.returncode or not (folder/dsc).is_file():
                raise SystemExit(f'Cannot fetch source package {source} {source_version}: {cache} does not hold it, and '
                    f'apt-get source needs deb-src entries and a current apt-get update: {fetched.stderr.strip()}')
        lines=[f"{library['soname']}  {library['package']} {library['version']}, "
            f"source package {library['source']} {library['source_version']}" for library in libraries]
        (folder/'README').write_text(f'Source code of the libraries in the lib/ folder of the Elarni {version} AppImage\n\n'
            'The AppImage carries these Ubuntu 22.04 libraries, changed only in their RUNPATH, which points each at the '
            'others\nbeside it. This folder holds the Ubuntu source package each one was built from, as apt-get source '
            'fetched it;\n"dpkg-source -x <name>.dsc" unpacks one. Their licences are in the AppImage, under '
            f'{BUNDLED_NOTICES}/<package>/copyright.\n\n'+'\n'.join(lines)+'\n')
        with tarfile.open(archive,'w') as output: output.add(folder,arcname=folder.name,filter=root_owned)

def build_appimage(bundle,destination,libraries):
    """Pack bundle, with the desktop entry, icon and the tray libraries, into the AppImage at destination. The
    libraries' licence files go with them; main writes their source archive beside it first."""
    with tempfile.TemporaryDirectory(prefix='elarni-appdir-') as temporary:
        appdir=Path(temporary).resolve()/'Elarni.AppDir'
        shutil.copytree(bundle,appdir,symlinks=True)
        for library in libraries:
            copy=appdir/'lib'/library['soname']
            shutil.copy2(library['path'],copy)
            # Each copy finds the others beside itself. LD_LIBRARY_PATH would do it for every process the app
            # starts, pkexec and the root helper among them.
            subprocess.run(['patchelf','--set-rpath','$ORIGIN',str(copy)],check=True)
            notice=appdir/BUNDLED_NOTICES/library['package']/'copyright'
            notice.parent.mkdir(parents=True,exist_ok=True)
            shutil.copy2(library['copyright'],notice)
        # The runner must load every carried library from the AppDir, not from this build system.
        loaded=subprocess.run(['ldd',str(appdir/'elarni')],check=True,capture_output=True,text=True).stdout
        for library in libraries:
            if f"{library['soname']} => {appdir/'lib'/library['soname']} " not in loaded:
                raise SystemExit(f"The AppImage's elarni does not load its own {library['soname']}:\n{loaded}")
        # The runtime starts AppRun in the mounted image; elarni finds lib/ and data/ beside itself.
        (appdir/'AppRun').symlink_to('elarni')
        shutil.copy2(ROOT/'linux/com.elarni.Elarni.desktop',appdir/'com.elarni.Elarni.desktop')
        shutil.copy2(ROOT/'linux/elarni.png',appdir/'com.elarni.Elarni.png')
        (appdir/'.DirIcon').symlink_to('com.elarni.Elarni.png')
        # Build containers have no FUSE, so appimagetool runs extracted.
        env=dict(os.environ,ARCH='x86_64',APPIMAGE_EXTRACT_AND_RUN='1')
        subprocess.run([str(appimage_tool('appimagetool')),'--no-appstream','--runtime-file',str(appimage_tool('runtime')),
            str(appdir),str(destination)],check=True,env=env,stdout=subprocess.DEVNULL)

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--bundle',type=Path,default=ROOT/'build/linux/x64/release/bundle')
    parser.add_argument('--output',type=Path,default=ROOT/'.build/linux-release')
    args=parser.parse_args()
    if args.output.resolve().is_relative_to(args.bundle.resolve()):
        parser.error('Output must be outside the input bundle')
    if sys.platform!='linux': raise SystemExit('Package the Ubuntu-built release on Linux.')
    require_files(args.bundle, ['LICENSE', 'NOTICE', 'THIRD_PARTY_NOTICES',
        'GOZXING_LICENSE.txt', 'XERRORS_LICENSE.txt', 'data/flutter_assets/version.json'])
    version=re.search(r'^version:\s*(\d+\.\d+\.\d+)\+(\d+)\s*$',(ROOT/'pubspec.yaml').read_text(),re.M)
    if not version: raise SystemExit('Unsupported app version.')
    # Packages take pubspec's version, so a stale build would ship under the new number.
    built=json.loads((args.bundle/'data/flutter_assets/version.json').read_text())
    if (built.get('version'),built.get('build_number'))!=version.groups():
        raise SystemExit('Bundle version differs from pubspec.yaml: '+str(built.get('version'))+'+'+str(built.get('build_number')))
    version='-'.join(version.groups())
    for name in ('elarni','elarni-cli','elarni-core','elarni-shadowquic','lib/libelarni_domain.so','lib/libflutter_linux_gtk.so','lib/libapp.so',
                 'lib/libelarni_camera.so'):
        path=args.bundle/name
        with path.open('rb') as source: header=source.read(20)
        if header[:4]!=b'\x7fELF' or header[4:6]!=b'\x02\x01' or header[18:20]!=b'\x3e\x00':
            raise SystemExit('Expected Linux x86-64 ELF: '+name)
    if not (args.bundle/'data/flutter_assets/AssetManifest.bin').is_file(): raise SystemExit('Missing Flutter assets.')
    # The AppImage's libraries, their licence files, notices and sources come before any package is written.
    libraries=bundled_libraries()
    check_notices(libraries,args.bundle/'THIRD_PARTY_NOTICES')
    prepare_output(args.output)
    sources=args.output/('elarni-'+version+'-linux-bundled-sources.tar')
    bundled_sources(libraries,sources,version)
    with tempfile.TemporaryDirectory(prefix='elarni-package-') as temporary:
        stage=Path(temporary)
        portable=stage/('elarni-'+version+'-linux-x64')
        shutil.copytree(args.bundle,portable,symlinks=True)
        for name in ('com.elarni.Elarni.desktop','install-desktop','README.md','HEADLESS.md','elarni.service'):
            shutil.copy2(ROOT/'linux'/name,portable/name)
        shutil.copy2(ROOT/'docs/HEADLESS.md',portable/'HEADLESS-CONTROL.md')
        (portable/'HEADLESS.md').write_text((portable/'HEADLESS.md').read_text().replace('../docs/HEADLESS.md','HEADLESS-CONTROL.md'))
        (portable/'HEADLESS-CONTROL.md').write_text((portable/'HEADLESS-CONTROL.md').read_text().replace('../linux/HEADLESS.md','HEADLESS.md').replace('linux/HEADLESS.md','HEADLESS.md'))
        (portable/'install-desktop').chmod(0o755)
        archive=args.output/(portable.name+'.tar.gz')
        with tarfile.open(archive,'w:gz') as output: output.add(portable,arcname=portable.name,filter=root_owned)
        package=stage/'deb';app=package/'opt/elarni'
        shutil.copytree(args.bundle,app,symlinks=True)
        doc=package/'usr/share/doc/elarni';doc.mkdir(parents=True)
        shutil.copy2(ROOT/'linux/README.md',doc/'README.md')
        shutil.copy2(ROOT/'linux/HEADLESS.md',doc/'HEADLESS.md')
        shutil.copy2(ROOT/'docs/HEADLESS.md',doc/'HEADLESS-CONTROL.md')
        (doc/'HEADLESS.md').write_text((doc/'HEADLESS.md').read_text().replace('../docs/HEADLESS.md','HEADLESS-CONTROL.md'))
        (doc/'HEADLESS-CONTROL.md').write_text((doc/'HEADLESS-CONTROL.md').read_text().replace('../linux/HEADLESS.md','HEADLESS.md').replace('linux/HEADLESS.md','HEADLESS.md'))
        units=package/'lib/systemd/system';units.mkdir(parents=True)
        shutil.copy2(ROOT/'linux/elarni.service',units/'elarni.service')
        applications=package/'usr/share/applications';applications.mkdir(parents=True)
        shutil.copy2(ROOT/'linux/com.elarni.Elarni.desktop',applications/'com.elarni.Elarni.desktop')
        icons=package/'usr/share/icons/hicolor/512x512/apps';icons.mkdir(parents=True)
        shutil.copy2(ROOT/'linux/elarni.png',icons/'com.elarni.Elarni.png')
        binary=package/'usr/bin';binary.mkdir(parents=True)
        (binary/'elarni').symlink_to('/opt/elarni/elarni')
        (binary/'elarni-cli').symlink_to('/opt/elarni/elarni-cli')
        control=package/'DEBIAN';control.mkdir()
        size=sum(path.stat().st_size for path in package.rglob('*') if path.is_file())//1024
        (control/'control').write_text(f'Package: elarni\nVersion: {version}\nArchitecture: amd64\n'
            f'Maintainer: Elarni contributors\nSection: net\nPriority: optional\nInstalled-Size: {size}\n'
            f'Depends: {DEPENDENCIES}\nRecommends: gnome-keyring, policykit-1-gnome\n'
            'Description: Elarni desktop proxy and VPN client\n'
            ' Shared desktop interface, encrypted profile storage and system VPN routing.\n')
        refresh=('#!/bin/sh\nset -e\nif command -v update-desktop-database >/dev/null 2>&1; then\n'
            '  update-desktop-database /usr/share/applications\nfi\n'
            'if command -v gtk-update-icon-cache >/dev/null 2>&1; then\n'
            '  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor\nfi\n'
            'if [ -d /run/systemd/system ]; then\n  systemctl daemon-reload\n')
        scripts={
            # A running root daemon must not keep serving replaced files after an upgrade.
            'postinst':refresh+'  if [ "$1" = configure ]; then systemctl try-restart elarni.service || true; fi\nfi\n',
            'postrm':refresh+'fi\n',
            'prerm':'#!/bin/sh\nset -e\nif [ "$1" = remove ] && [ -d /run/systemd/system ]; then\n'
                '  systemctl stop elarni.service || true\nfi\n',
        }
        for script,body in scripts.items():
            path=control/script
            path.write_text(body)
            path.chmod(0o755)
        # --root-owner-group fixes owners only; pkexec runs /opt/elarni/elarni-core as root.
        for path in (package,*package.rglob('*')):
            if not path.is_symlink(): path.chmod(path.stat().st_mode&~0o022)
        deb=args.output/('elarni_'+version+'_amd64.deb')
        subprocess.run(['dpkg-deb','--build','--root-owner-group',str(package),str(deb)],check=True)
        subprocess.run(['desktop-file-validate',str(applications/'com.elarni.Elarni.desktop')],check=True)
        appimage=args.output/('Elarni-'+version+'-x86_64.AppImage')
        build_appimage(args.bundle,appimage,libraries)
        write_manifest(args.output, [deb, appimage, archive, sources], 'linux-x64', 'unsigned-candidate')
        print(json.dumps({'deb':str(deb.resolve()),'appimage':str(appimage.resolve()),'portable':str(archive.resolve()),
            'bundledSources':str(sources.resolve()),'version':version}),flush=True)

if __name__=='__main__': main()
